{
  "expo": {
    "name": "DZ Connect",
    "slug": "dz-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dzconnect",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dzconnect.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "DZ Connect needs access to your photos so you can add profile pictures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f1419"
      },
      "package": "com.dzconnect.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f1419",
          "imageWidth": 200
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
