{
  "name": "dz-connect",
  "version": "0.1.0",
  "description": "Social discovery app for Algeria — MVP0 foundation (Expo + Supabase)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "prepare": "husky",
    "gen:types": "supabase gen types typescript --linked > types/database.ts",
    "gen:types:local": "node scripts/gen-types-local.mjs",
    "db:new": "supabase migration new",
    "db:reset": "supabase db reset",
    "seed:dev": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "~57.0.21",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "libphonenumber-js": "1.13.12",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.19",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "react-test-renderer": "19.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "private": true,
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "react-server-dom-webpack": "19.0.0",
    "react-dom": "19.1.0"
  },
  "lint-staged": {
    "*": [
      "node scripts/scan-secrets.mjs"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,sql}": [
      "prettier --write"
    ]
  }
}
