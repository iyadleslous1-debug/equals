# Local dev template — copy to `.env` (gitignored) and fill in.
# Two options:
#  1. Cloud dev project (recommended for MVP0): paste its URL + anon key below.
#  2. Local stack (`npx supabase start`): use http://localhost:54321 — loopback
#     HTTP is allowed when EXPO_PUBLIC_APP_ENV is not production.
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
EXPO_PUBLIC_SMS_PROVIDER=disabled
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_LOG_LEVEL=debug
EXPO_PUBLIC_ERROR_REPORTER=console
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
