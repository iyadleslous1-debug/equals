# Copy to `.env` (gitignored) and fill in — or copy the per-environment
# template that matches what you're running:
#   .env.development  → local dev (default)
#   .env.staging      → staging project (doesn't exist yet)
#   .env.production   → production project (doesn't exist yet)
# See README "Environments" for the switching procedure.
EXPO_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# DORMANT in MVP0 (email auth only — no SMS is sent). Kept so the future
# phone/OTP method needs no config-shape change. Values: twilio | algerian | disabled
EXPO_PUBLIC_SMS_PROVIDER=disabled

# development | staging | production. Drives log verbosity, prod guards, warnings.
EXPO_PUBLIC_APP_ENV=development

# Optional. Defaults per env (debug/info/warn). Values: debug | info | warn | error
# EXPO_PUBLIC_LOG_LEVEL=debug

# Optional. Crash reporter: console | sentry (sentry needs the DSN below).
EXPO_PUBLIC_ERROR_REPORTER=console
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=
